def retention(hold: bool, audit: bool, consent: bool) -> int | None:
    if hold:
        return None
    if audit:
        return 365
    return 30 if consent else 7


def api_retention(hold: bool, audit: bool, consent: bool) -> int | None:
    return retention(hold, audit, consent)


def worker_retention(hold: bool, audit: bool, consent: bool) -> int | None:
    return retention(hold, audit, consent)
