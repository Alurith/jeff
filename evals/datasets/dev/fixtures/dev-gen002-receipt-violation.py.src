import sqlite3


def show_receipt(db: sqlite3.Connection, code: str) -> str:
    row = db.execute(
        "SELECT amount FROM receipts WHERE code = ?", (code,)
    ).fetchone()
    if row is None:
        raise LookupError(code)
    db.execute("UPDATE receipts SET exported = 1 WHERE code = ?", (code,))
    return f"amount={row[0]}"
